<?xml version="1.0" encoding="utf-8"?>
<!--
    "Look inside": the preview sheet from the shared design spec
    (docs/superpowers/specs/2026-08-08-contributor-shell-shared-design.md,
    "## The review moment"). That document specifies the copy for every
    shell, so the strings here are transcription rather than authorship, and
    the macOS sheet is the reference implementation.

    Until this existed the Windows app could not contribute anything at all:
    nothing in it called approve or dismiss, and TcPreview was implemented and
    tested with no caller.

    A UserControl rather than the window itself, and that is not cosmetic. The
    transcript panel below uses x:Load, whose generated code calls FindName on
    the root element. A WinUI Window is not a FrameworkElement and has no
    FindName, so x:Load cannot be used directly on one. The gate depends on
    x:Load (see the panel), so the sheet lives in a control the window hosts.

    Four tabs in the spec's order, Search first and focused, and Contribute in
    the footer and nowhere else. The queue row has no approve button on
    purpose, because approving from the row is approving without looking.

    Contribute is armed by one thing, a preview that actually loaded and
    pinned. It used to wait on a read gate as well (transcript tab shown, plus
    an acknowledgement ticked); that came out as friction, and the sentence it
    carried is printed above the buttons instead. See PreviewSheetViewModel and
    TraceCommons.Interop.ReadGate.

    XML comments cannot contain a double hyphen, so the prose here uses commas
    and parentheses where the C# files use dashes.
-->
<UserControl
    x:Class="TraceCommons.App.Controls.PreviewSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TraceCommons.App.ViewModels"
    xmlns:interop="using:TraceCommons.Interop"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinWidth="720"
    MinHeight="560">

    <Grid Background="{ThemeResource TcWindowBackgroundBrush}"
          RowDefinitions="Auto,Auto,*,Auto">

        <!--
            Header: the same identity line and the same labelled figures as
            the queue card, in the same order. Recognising the card you just
            clicked is one of the quieter things that makes a preview
            trustworthy.
        -->
        <StackPanel Grid.Row="0"
                    Spacing="8"
                    Padding="20,14"
                    Background="{ThemeResource TcSurfaceCardBrush}"
                    BorderBrush="{ThemeResource TcHairlineDividerBrush}"
                    BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0"
                           Text="{x:Bind ViewModel.Entry.ProjectLabel}"
                           Style="{StaticResource TcTitleCardTextStyle}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.Entry.Source}"
                           Style="{StaticResource TcCaptionTextStyle}" />
                <TextBlock Grid.Column="2"
                           Text="{x:Bind ViewModel.Entry.DiscoveredText}"
                           Style="{StaticResource TcCaptionTextStyle}"
                           Foreground="{ThemeResource TcInkTertiaryBrush}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="28">
                <!--
                    "Would send" is the redacted envelope, which only a
                    preview knows. The queue row prints the session file on
                    disk instead and labels it as such: the two are different
                    numbers, and labelling one as the other would be the app's
                    first false statement about what leaves the machine.
                -->
                <StackPanel Spacing="2">
                    <TextBlock Text="Would send" Style="{StaticResource TcEyebrowTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ProbabilitySummary, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.WouldSendText, Mode=OneWay}"
                               Style="{StaticResource TcMonoFigureTextStyle}" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Session on disk" Style="{StaticResource TcEyebrowTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.RawSessionText, Mode=OneWay}"
                               Style="{StaticResource TcMonoFigureTextStyle}" />
                </StackPanel>
                <!--
                    The redaction receipt. It proves scrubbing ran, and it
                    calibrates: "nothing matched" on a session that obviously
                    touched a .env is a signal the contributor can act on,
                    which is why that case is drawn in the attention tone
                    rather than reassured over.
                -->
                <StackPanel Spacing="2">
                    <TextBlock Text="Scrubbing found" Style="{StaticResource TcEyebrowTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ScrubbingFoundText, Mode=OneWay}"
                               Style="{StaticResource TcMonoFigureTextStyle}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Nothing has been sent. This is what would be."
                       Style="{StaticResource TcCaptionTextStyle}" />
        </StackPanel>

        <!--
            The tab strip. Plain buttons rather than a NavigationView: two of
            the four carry a count, so a contributor can see there is
            something to look at before clicking the tab.
        -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    Padding="20,10,20,0"
                    Visibility="{x:Bind ViewModel.IsShowingContent, Mode=OneWay}">
            <Button Style="{StaticResource TcSecondaryButtonStyle}"
                    Click="OnSearchTab"
                    Content="Search" />
            <Button Style="{StaticResource TcSecondaryButtonStyle}"
                    Click="OnWhatsInItTab">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="What's in it" />
                    <TextBlock Text="{x:Bind ViewModel.RedactionBadge, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.HasRedactionBadge, Mode=OneWay}"
                               Style="{StaticResource TcMonoBadgeTextStyle}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource TcSecondaryButtonStyle}"
                    Click="OnTranscriptTab"
                    Content="Exactly what would be sent" />
            <Button Style="{StaticResource TcSecondaryButtonStyle}"
                    Click="OnPermissionsTab">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Permissions" />
                    <TextBlock Text="{x:Bind ViewModel.PermissionsBadge, Mode=OneWay}"
                               Style="{StaticResource TcMonoBadgeTextStyle}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid Grid.Row="2" Padding="20,14">

            <!-- While the redaction pass runs. It reads the session and
                 redacts it locally, which on a large trace takes a moment. -->
            <StackPanel Spacing="6"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.LoadingTitle, Mode=OneWay}"
                           Style="{StaticResource TcTitleCardTextStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.LoadingDetail, Mode=OneWay}"
                           Style="{StaticResource TcCaptionTextStyle}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- A preview that could not be opened or could not be read. The
                 second sentence is the one that matters: the failure costs
                 the contributor nothing. -->
            <StackPanel Spacing="6"
                        MaxWidth="420"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasFailed, Mode=OneWay}">
                <TextBlock Text="This one can't be shown."
                           Style="{StaticResource TcHeadingAlertTextStyle}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.PreviewFailureDetail, Mode=OneWay}"
                           Style="{StaticResource TcCaptionTextStyle}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <Button Content="{x:Bind ViewModel.WitnessAction}" Click="OnWitnessReview"
                        Visibility="{x:Bind ViewModel.CanRequestWitness, Mode=OneWay}" />
            </StackPanel>

            <!--
                1. Search. The highest value affordance in the product: type a
                client name, get 0 matches or jump to context, without reading
                148 turns.
            -->
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
                  Visibility="{x:Bind ViewModel.IsSearchTab, Mode=OneWay}">
                <TextBlock Grid.Row="0"
                           Text="Search this trace for anything you need to be sure isn't in it."
                           Style="{StaticResource TcBodyTextStyle}"
                           TextWrapping="Wrap" />
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,10,0,0">
                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             PlaceholderText="Client name, hostname, anything"
                             Text="{x:Bind ViewModel.Needle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="OnNeedleChanged"
                             KeyDown="OnSearchKeyDown" />
                    <Button Grid.Column="1"
                            Style="{StaticResource TcSecondaryButtonStyle}"
                            Content="Search"
                            Click="OnSearchClick" />
                </Grid>

                <!-- The contributor's own earlier questions, one click away.
                     Kept in memory only, never written to disk: see
                     PreviewSheetViewModel. -->
                <ItemsControl Grid.Row="2"
                              Margin="0,8,0,0"
                              ItemsSource="{x:Bind ViewModel.RecentSearches, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Style="{StaticResource TcSecondaryButtonStyle}"
                                    Content="{x:Bind}"
                                    Click="OnRecentSearchClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="3" Spacing="4" Margin="0,12,0,0">
                    <TextBlock Text="{x:Bind ViewModel.SearchResultText, Mode=OneWay}"
                               Style="{StaticResource TcHeadingAlertTextStyle}" />
                    <!-- A search that found nothing is not evidence that
                         nothing is there, and this is where that is said
                         rather than implied. -->
                    <TextBlock Text="{x:Bind ViewModel.NothingMatchedNote}"
                               Visibility="{x:Bind ViewModel.ShowNothingMatchedNote, Mode=OneWay}"
                               Style="{StaticResource TcCaptionTextStyle}"
                               TextWrapping="Wrap" />

                    <!--
                        Whether a value the search found was actually taken
                        out. tc_preview_search scans the REDACTED body, so a
                        value scrubbing removed returns zero matches there,
                        which is indistinguishable from a value that was never
                        present. Those are the two answers a worried
                        contributor most needs to tell apart.

                        Answered only for a COMMITTED search (Enter or the
                        button), because it costs the daemon a re-read of the
                        session file. Absent until then, so the tab says
                        nothing rather than something it has not checked. The
                        attention tone is reserved for a value still in what
                        would be sent: a check that could not be made is
                        unproven, not alarming, and its own sentence says so.
                    -->
                    <TextBlock Text="{x:Bind ViewModel.OriginalOutcomeText, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.OriginalOutcomeIsCalm, Mode=OneWay}"
                               Style="{StaticResource TcCaptionTextStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.OriginalOutcomeText, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.OriginalOutcomeIsAlarming, Mode=OneWay}"
                               Foreground="{ThemeResource TcGoldTextBrush}"
                               Style="{StaticResource TcCaptionTextStyle}"
                               TextWrapping="Wrap" />

                    <!-- A secret the scan FOUND and did not remove.
                         redaction_counts carries residual_secret_at:* in the
                         same map as every genuine removal, and the figures
                         above render under headings that say "removed"; those
                         figures now exclude it. Excluding it is only half the
                         fix. Saying nothing would trade a wrong statement for
                         silence about a secret still in the payload. This is
                         the other half. -->
                    <TextBlock Text="{x:Bind ViewModel.SurvivingSecrets, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.HasSurvivingSecrets, Mode=OneWay}"
                               Foreground="{ThemeResource TcGoldTextBrush}"
                               Style="{StaticResource TcCaptionTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer Grid.Row="4" Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Excerpts, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Background="{ThemeResource TcSurfaceScrimBrush}"
                                        CornerRadius="{StaticResource TcControlCornerRadius}"
                                        Padding="10,8"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="{x:Bind}"
                                               Style="{StaticResource TcMonoCodeTextStyle}"
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 2. What's in it. -->
            <ScrollViewer Visibility="{x:Bind ViewModel.IsWhatsInItTab, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.TurnsText, Mode=OneWay}"
                               Style="{StaticResource TcMetricValueTextStyle}" />
                    <TextBlock Text="Turns recorded" Style="{StaticResource TcEyebrowTextStyle}" />

                    <TextBlock Text="What scrubbing removed"
                               Style="{StaticResource TcTitleCardTextStyle}"
                               Margin="0,10,0,0" />
                    <!--
                        The one card here drawn to be found. A session where no
                        pattern fired is the session most worth a second look,
                        and it is the case a count cannot state.

                        It is a Button now, and the tone is unchanged: the
                        complaint it answers was that the chip said nothing to
                        DO, which is an affordance complaint and not a
                        complaint about the colour. Activating it opens the
                        search tab, which is the thing to do about it, and the
                        line says so. A Button rather than a tapped Border for
                        the same reason the navigation rail uses one: keyboard
                        focus, the invoke pattern and a narrator announcement
                        come with it.

                        The sentence is bound from ScrubbingCaveatCopy, where
                        three shells are kept from drifting into three wordings
                        of it.
                    -->
                    <Button Visibility="{x:Bind ViewModel.NothingMatched, Mode=OneWay}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="{ThemeResource TcSurfaceInsetBrush}"
                            BorderBrush="{ThemeResource TcGoldAttentionBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource TcCardCornerRadius}"
                            Padding="12,10"
                            Click="OnNothingMatchedChip"
                            AutomationProperties.Name="Search this trace">
                        <TextBlock Text="{x:Bind ViewModel.NothingMatchedLine, Mode=OneWay}"
                                   Style="{StaticResource TcBodyTextStyle}"
                                   TextWrapping="Wrap" />
                    </Button>
                    <!--
                        One row per category, with what that category IS. The
                        card's one line figure is the only at a glance part
                        otherwise, and it is a count, not a list. No matched
                        text ever appears here: the value is gone by
                        construction and the row says what KIND of thing left,
                        not what it was.

                        The rows, their descriptions and their order are
                        RedactionSummary.Rows', in TraceCommons.Interop, where
                        they are tested. An unrecognised family keeps a neutral
                        description and is never dropped, because hiding a
                        category this build has no words for would understate
                        what happened.
                    -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.RemovedCategories, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="interop:RedactionSummaryRow">
                                <StackPanel Spacing="2" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind Display}"
                                                   Style="{StaticResource TcBodyTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind CountText}"
                                                   Style="{StaticResource TcMonoFigureTextStyle}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Description}"
                                               Style="{StaticResource TcCaptionTextStyle}"
                                               Foreground="{ThemeResource TcInkSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind DetailText}"
                                               Visibility="{x:Bind HasDetail}"
                                               Style="{StaticResource TcCaptionSmallTextStyle}"
                                               Foreground="{ThemeResource TcInkTertiaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        The other half, and the reason this panel is worth
                        building. residual_secret_at counts a secret the scan
                        DETECTED AND DID NOT REMOVE, it arrives in the same map
                        as every genuine removal, and every shell used to draw
                        that whole map under a heading saying "removed". A
                        session with a surviving secret therefore reported it as
                        a thing that had been taken out.

                        Collapsed entirely when there are none, so a clean
                        session carries no alarm.
                    -->
                    <StackPanel Spacing="6"
                                Margin="0,10,0,0"
                                Visibility="{x:Bind ViewModel.HasStillPresentCategories, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;"
                                      FontSize="14"
                                      Foreground="{ThemeResource TcGoldTextBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="Found, and still in what would be sent"
                                       Style="{StaticResource TcTitleCardTextStyle}"
                                       Foreground="{ThemeResource TcGoldTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.StillPresentCategories, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="interop:RedactionSummaryRow">
                                    <StackPanel Spacing="2" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind Description}"
                                                       Style="{StaticResource TcBodyTextStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind CountText}"
                                                       Style="{StaticResource TcMonoFigureTextStyle}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <!-- The schema paths, so a contributor
                                             can go and look. Schema shaped
                                             identifiers by construction, never
                                             transcript text. -->
                                        <TextBlock Text="{x:Bind DetailText}"
                                                   Visibility="{x:Bind HasDetail}"
                                                   Style="{StaticResource TcMonoCodeTextStyle}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- A panel that enumerates categories makes the app look
                         more thorough than it is, which is exactly when this
                         sentence earns its place. Word for word what the
                         footer and the queue print, so a person who read it
                         there recognises it here. -->
                    <TextBlock Text="{x:Bind ViewModel.ScrubbingCaveatSentence}"
                               Style="{StaticResource TcCaptionTextStyle}"
                               Foreground="{ThemeResource TcInkSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <StackPanel Spacing="4"
                                Margin="0,10,0,0"
                                Visibility="{x:Bind ViewModel.HasPiiLabels, Mode=OneWay}">
                        <TextBlock Text="Personal-information categories seen"
                                   Style="{StaticResource TcTitleCardTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.PiiLabelsText, Mode=OneWay}"
                                   Style="{StaticResource TcBodyTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Categories only. The matched text is never reported here."
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Text="Residual risk"
                               Style="{StaticResource TcTitleCardTextStyle}"
                               Margin="0,10,0,0" />
                    <TextBlock Text="{x:Bind ViewModel.ResidualRiskText, Mode=OneWay}"
                               Style="{StaticResource TcBodyTextStyle}"
                               TextWrapping="Wrap" />
                    <!-- The spec's queue row lists files touched and tools
                         invoked. The preview contract carries neither, so
                         they are absent rather than guessed at. -->
                    <TextBlock Text="Files touched and tools invoked are not in this contract's preview summary, so they are not shown rather than guessed at."
                               Style="{StaticResource TcCaptionSmallTextStyle}"
                               Foreground="{ThemeResource TcInkSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!--
                3. Exactly what would be sent.

                x:Load rather than Visibility, and this is load bearing: a
                collapsed element still exists and still raises Loaded, so a
                Visibility toggle would let the read gate record a transcript
                that was never on screen. With x:Load the panel is not created
                until the tab is selected, so its realization IS its display,
                and OnTranscriptRealized is the only thing that arms the first
                half of the gate.
            -->
            <ScrollViewer x:Name="TranscriptPanel"
                          x:Load="{x:Bind ViewModel.IsTranscriptTab, Mode=OneWay}"
                          Loaded="OnTranscriptRealized"
                          ViewChanged="OnTranscriptScrolled"
                          SizeChanged="OnTranscriptResized">
                <StackPanel x:Name="TranscriptContent" Spacing="8">
                    <TextBlock Text="These are the exact bytes an approval covers. Marks like &lt;PRIVATE_SECRET_1&gt; show where scrubbing fired, legible as chips, not holes."
                               Style="{StaticResource TcCaptionTextStyle}"
                               TextWrapping="Wrap" />
                    <!--
                        Every byte is here. Only the chunks near the viewport
                        are typeset, and chunks that scroll away are dropped,
                        so what is bounded is glyph storage rather than what
                        the reader can reach. Selection therefore covers one
                        block at a time, which is what the Copy everything
                        button is for: it puts the whole redacted body on the
                        clipboard, and copying is a string copy rather than a
                        layout.
                    -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TranscriptSizeCaption"
                                   Grid.Column="0"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcInkSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button x:Name="TranscriptCopyAll"
                                Grid.Column="1"
                                Style="{StaticResource TcSecondaryButtonStyle}"
                                Content="Copy everything"
                                Click="OnCopyWholeTranscript"
                                ToolTipService.ToolTip="Puts the whole redacted body on the clipboard. Selection inside the transcript covers one block at a time." />
                    </Grid>
                    <Border Background="{ThemeResource TcSurfaceCardBrush}"
                            BorderBrush="{ThemeResource TcHairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource TcCardCornerRadius}"
                            Padding="12,10">
                        <!--
                            Three parts, filled from code behind. The two
                            spacers stand in for every chunk that is not
                            typeset, so the scroll extent is the whole body's
                            rather than the resident window's; the middle
                            panel holds one RichTextBlock per resident chunk,
                            each built from TranscriptMarkers.Split so the
                            markers draw as chips. A plain TextBlock cannot
                            carry two foregrounds, which is why these are
                            RichTextBlocks.

                            One element per chunk across a 17.5 MB body would
                            be 4,480 elements in a panel that does not
                            virtualise. The spacers are what keep the element
                            count bounded by the retention ceiling instead,
                            whatever the size of the trace.
                        -->
                        <StackPanel x:Name="TranscriptBodyHost" Orientation="Vertical">
                            <Border x:Name="TranscriptSpacerAbove" Height="0" />
                            <StackPanel x:Name="TranscriptChunks" Orientation="Vertical" />
                            <Border x:Name="TranscriptSpacerBelow" Height="0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 4. Permissions, restated at the moment of consent rather than
                 only at onboarding. -->
            <ScrollViewer Visibility="{x:Bind ViewModel.IsPermissionsTab, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="What this upload asks for"
                               Style="{StaticResource TcTitleCardTextStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Permissions, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PermissionRow">
                                <TextBlock Text="{x:Bind Title}"
                                           Style="{StaticResource TcBodyTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="These are the permissions this device requests. Trace Commons can narrow them, never widen them, and if your permissions change between now and sending, this approval stops applying and you are asked again."
                               Style="{StaticResource TcCaptionTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--
            The footer: the caveat, the read gate, and the only approve control
            in the product.
        -->
        <StackPanel Grid.Row="3"
                    Spacing="10"
                    Padding="20,12"
                    Background="{ThemeResource TcSurfaceCardBrush}"
                    BorderBrush="{ThemeResource TcHairlineDividerBrush}"
                    BorderThickness="0,1,0,0">

            <!-- Word for word what the queue window prints under the list. It
                 has to be identical in both places, so that a person who read
                 it there recognises it here rather than reading a second,
                 weaker message. -->
            <TextBlock Text="{x:Bind ViewModel.ScrubbingCaveatSentence}"
                       Style="{StaticResource TcCaptionTextStyle}"
                       TextWrapping="Wrap" />

            <!-- What the acknowledgement checkbox used to make a contributor
                 tick, said as a statement instead, in the place the tick used
                 to be asked for. Bound rather than typed out: the same
                 sentence is printed by the macOS and Linux sheets, and
                 TraceCommons.Interop.ReadGate is the one copy of it. -->
            <TextBlock Text="{x:Bind ViewModel.GateStatement}"
                       Style="{StaticResource TcCaptionSmallTextStyle}"
                       Foreground="{ThemeResource TcInkSecondaryBrush}"
                       TextWrapping="Wrap" />

            <!--
                The verdict question. Optional, and it never gates
                Contribute: no selection is the default and a perfectly
                valid answer, which is why these are ToggleButtons starting
                unchecked and not a RadioButtons group. Clicking the checked
                one clears it again, so a contributor can get back to having
                said nothing.

                The strings are bound from TraceCommons.Interop.VerdictCopy,
                which is where three shells are kept from drifting into three
                wordings of one question.
            -->
            <TextBlock Text="{x:Bind ViewModel.VerdictQuestion}"
                       Style="{StaticResource TcCaptionTextStyle}"
                       TextWrapping="Wrap" />

            <TextBlock Text="{x:Bind ViewModel.ImmutableNote, Mode=OneWay}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleButton IsEnabled="{x:Bind ViewModel.CanEditOutcome, Mode=OneWay}"
                              Content="{x:Bind ViewModel.VerdictWorkedLabel}"
                              IsChecked="{x:Bind ViewModel.IsWorkedSelected, Mode=OneWay}"
                              Click="OnVerdictWorked" />
                <ToggleButton IsEnabled="{x:Bind ViewModel.CanEditOutcome, Mode=OneWay}"
                              Content="{x:Bind ViewModel.VerdictPartlyLabel}"
                              IsChecked="{x:Bind ViewModel.IsPartlySelected, Mode=OneWay}"
                              Click="OnVerdictPartly" />
                <ToggleButton IsEnabled="{x:Bind ViewModel.CanEditOutcome, Mode=OneWay}"
                              Content="{x:Bind ViewModel.VerdictFailedLabel}"
                              IsChecked="{x:Bind ViewModel.IsFailedSelected, Mode=OneWay}"
                              Click="OnVerdictFailed" />
            </StackPanel>

            <!-- Load-bearing, not decoration: the outcome fields sit outside
                 the "exactly what would be sent" guarantee everything above
                 this makes, and this sentence is where a contributor is told
                 so. Do not reword or drop it. -->
            <TextBlock Text="{x:Bind ViewModel.VerdictCaption}"
                       Style="{StaticResource TcCaptionSmallTextStyle}"
                       Foreground="{ThemeResource TcInkTertiaryBrush}"
                       TextWrapping="Wrap" />

            <!--
                The correction control. Shown only under Partly and Failed:
                you cannot correct a run you have just called successful,
                and the gate is a guard as much as it is semantics. It
                halves the surface for correction-shaped credit farming and
                puts the field only where a correction means something.

                NOTE for anyone editing the comments in this file: a double
                hyphen is illegal inside an XML comment, and XamlCompiler.exe
                answers one by exiting 1 with no diagnostic at all. Where the
                rest of the repo would write a spaced double hyphen, write a
                full stop or a semicolon here.

                Optional throughout. Contribute is never gated on it.
            -->
            <StackPanel Spacing="6"
                        Visibility="{x:Bind ViewModel.IsCorrectionOffered, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.CorrectionQuestion}"
                           Style="{StaticResource TcCaptionTextStyle}"
                           TextWrapping="Wrap" />
                <TextBox IsEnabled="{x:Bind ViewModel.CanEditOutcome, Mode=OneWay}" PlaceholderText="{x:Bind ViewModel.CorrectionPlaceholder}"
                         Text="{x:Bind ViewModel.Correction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="64"
                         MaxHeight="140"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <!-- THE disclosure. Everything else on this sheet is
                     scrubbed here and scrubbed again on the server; a
                     correction is the one exception, and the published
                     policy page does not yet say so. Until it does, this
                     sentence is the whole of what a contributor is told.
                     Do not shorten it for layout; change the layout. -->
                <TextBlock Text="{x:Bind ViewModel.CorrectionCaption}"
                           Style="{StaticResource TcCaptionSmallTextStyle}"
                           Foreground="{ThemeResource TcInkTertiaryBrush}"
                           TextWrapping="Wrap" />
                <!-- The credential refusal, in its own words rather than as
                     a line in the submit toast: it is the only submit
                     failure the contributor caused and the only one they
                     can fix, and it asks for two things: edit the text,
                     and rotate what was typed. Nothing was sent. -->
                <Border Visibility="{x:Bind ViewModel.WasRefusedForACorrectionCredential, Mode=OneWay}"
                        Background="{ThemeResource TcSurfaceInsetBrush}"
                        BorderBrush="{ThemeResource TcGoldAttentionBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Padding="12,10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.CorrectionRefusalHeadline}"
                                   Style="{StaticResource TcBodyTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.CorrectionRefusalBody}"
                                   Style="{StaticResource TcCaptionSmallTextStyle}"
                                   Foreground="{ThemeResource TcInkSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--
                Whether this session can be contributed at all, above the
                buttons that act on it.

                Contribute is DISABLED rather than hidden here, unlike on the
                queue row: on the row the button's absence is read against its
                siblings, but this is the sheet a contributor opened on
                purpose to reach that one control, and a control that is gone
                from the place it was expected reads as a broken window. The
                sentences below say why it will not press.

                Absent entirely for an invited contributor, who has no
                eligibility question. Every binding OneWay: a submit-time
                failure writes its reason back into the entry.
            -->
            <StackPanel Spacing="2"
                        Visibility="{x:Bind ViewModel.HasEligibilityText, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.EligibilityText, Mode=OneWay}"
                           Style="{StaticResource TcCaptionTextStyle}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.EligibilityReasonText, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.HasEligibilityReason, Mode=OneWay}"
                           Style="{StaticResource TcCaptionSmallTextStyle}"
                           Foreground="{ThemeResource TcInkSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!--
                Admission preparation, drawn on every preview in the place the
                Linux shell has always drawn it, rather than only where a
                preview failed.

                It arms this session's NEXT call; the copy says so, and asks
                the contributor to continue the agent task and come back. So
                it is a thing someone opens the sheet to do, not a remedy for
                a sheet that broke. While it lived in the failed-preview
                notice, the only route to it was a witness review that failed
                first.

                CanPrepareAdmission is false unless the daemon says this
                contributor's enrolment admits evidence-bearing contribution,
                so an invited contributor, whom it could only refuse, is not
                offered it at all. Visibility, not IsEnabled: absent, not
                present and refusing.
            -->
            <Button Content="{x:Bind ViewModel.AdmissionHeading}" Click="OnPrepareAdmission"
                    Visibility="{x:Bind ViewModel.CanPrepareAdmission, Mode=OneWay}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.AdmissionGlyph, Mode=OneWay}" Style="{StaticResource TcHeadingAlertTextStyle}" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AdmissionRefusalMessage, Mode=OneWay}" Style="{StaticResource TcHeadingAlertTextStyle}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AdmissionNeutralMessage, Mode=OneWay}" TextWrapping="Wrap" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <!-- Outlined like Close, never filled: it must not read as a
                     second way to approve. -->
                <Button Grid.Column="0"
                        Style="{StaticResource TcSecondaryButtonStyle}"
                        Content="Not this one"
                        IsEnabled="{x:Bind ViewModel.CanDecide, Mode=OneWay}"
                        ToolTipService.ToolTip="Skips this session for good, even if you keep working in it. This project will keep being offered."
                        Click="OnNotThisOne" />
                <Button Grid.Column="2"
                        Style="{StaticResource TcSecondaryButtonStyle}"
                        Content="Close"
                        Click="OnClose" />
                <!--
                    The ONLY approve control in the product. It is behind the
                    preview by design, behind the read gate by design, and it
                    carries NO keyboard accelerator and is not the default
                    button: an irreversible send one Return away from a hand
                    resting on the keyboard is exactly the misclick this sheet
                    exists to prevent.
                -->
                <Button Grid.Column="3"
                        Style="{StaticResource TcPrimaryButtonStyle}"
                        Content="Contribute"
                        IsEnabled="{x:Bind ViewModel.CanContribute, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ContributeHelp, Mode=OneWay}"
                        Click="OnContribute" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
