<?xml version="1.0" encoding="utf-8"?>
<!--
    The complete device Settings screen, plus the public profile from section
    5.6 of the design spec.

    Every value comes from the daemon or the operating system. Timing edits
    send one set_settings key at a time, project changes use opaque project
    ids, and the local audit log contains fixed labels only.

    Two surfaces, not two states of one. Off the roster this is a single
    control that grants nothing and opens a consent dialog; on it, it is a
    panel of the fields that are actually published. The change of surface IS
    the statement about where the public boundary is, which is why the two are
    separate elements rather than one restyled into the other.

    The footnote sits OUTSIDE the panel, in the window's own type: it is this
    window talking about the public surface, not part of it.

    XML comments cannot contain a double hyphen, so the prose here uses commas
    and parentheses where the C# files use dashes.
-->
<UserControl
    x:Class="TraceCommons.App.Controls.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TraceCommons.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0"
                    Spacing="2"
                    Padding="20,9"
                    BorderBrush="{ThemeResource TcHairlineDividerBrush}"
                    BorderThickness="0,0,0,1">
            <TextBlock Text="Settings" Style="{StaticResource TcTitleScreenTextStyle}" />
            <TextBlock Text="What this machine watches, and what your traces are allowed to do."
                       Style="{StaticResource TcCaptionTextStyle}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="22,16,22,16">
            <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">

                <TextBlock Text="CONNECTION"
                           Style="{StaticResource TcEyebrowTextStyle}" />
                <Border Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Padding="14,12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind Settings.ConnectionText, Mode=OneWay}"
                                   Style="{StaticResource TcTitleCardTextStyle}" />
                        <TextBlock Text="{x:Bind Settings.ConnectionDetail, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.HasConnectionDetail, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{x:Bind Settings.ConnectionRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConnectionStatusViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,2">
                                        <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Text}"
                                                   Style="{StaticResource TcBodyDenseTextStyle}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind State}"
                                                   Style="{StaticResource TcMonoChipTextStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="STARTUP"
                           Style="{StaticResource TcEyebrowTextStyle}"
                           Visibility="{x:Bind Settings.StartupSupported, Mode=OneWay}" />
                <ToggleSwitch Header="Start Trace Commons when you sign in"
                              IsOn="{x:Bind Settings.StartAtLogin, Mode=OneWay}"
                              IsEnabled="{x:Bind Settings.IsNotBusy, Mode=OneWay}"
                              Visibility="{x:Bind Settings.StartupSupported, Mode=OneWay}"
                              Toggled="OnStartAtLoginToggled" />

                <TextBlock Text="HOW MAY YOUR TRACES BE USED?"
                           Style="{StaticResource TcEyebrowTextStyle}" />
                <TextBlock Text="Applies to traces you send from now on."
                           Style="{StaticResource TcCaptionTextStyle}" />

                <TextBlock Text="ALWAYS INCLUDED"
                           Style="{StaticResource TcCaptionSmallTextStyle}" />
                <ItemsControl ItemsSource="{x:Bind Settings.AlwaysIncluded}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConsentScopeViewModel">
                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                      IsEnabled="False"
                                      Margin="0,2">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Title}"
                                               Style="{StaticResource TcTitleCardTextStyle}" />
                                    <TextBlock Text="{x:Bind Description}"
                                               Style="{StaticResource TcCaptionTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="OPTIONAL — EACH ONE LETS YOUR TRACES DO MORE"
                           Style="{StaticResource TcCaptionSmallTextStyle}" />
                <ItemsControl ItemsSource="{x:Bind Settings.OptionalScopes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConsentScopeViewModel">
                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                      IsEnabled="{x:Bind IsEnabled}"
                                      Click="OnConsentChanged"
                                      Margin="0,2">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Title}"
                                               Style="{StaticResource TcTitleCardTextStyle}" />
                                    <TextBlock Text="{x:Bind Description}"
                                               Style="{StaticResource TcCaptionTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Nothing here is pre-selected on your behalf."
                           Style="{StaticResource TcCaptionTextStyle}" />

                <TextBlock Text="HOW IT BEHAVES"
                           Style="{StaticResource TcEyebrowTextStyle}" />
                <Border Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Padding="14,12">
                    <StackPanel Spacing="10">
                        <NumberBox x:Name="QuiescenceMinutes"
                                   Header="Quiet time before a session counts as finished (minutes)"
                                   Value="{x:Bind Settings.QuiescenceMinutes, Mode=OneWay}"
                                   Minimum="1"
                                   Maximum="240"
                                   SmallChange="1"
                                   SpinButtonPlacementMode="Inline"
                                   IsEnabled="{x:Bind Settings.IsNotBusy, Mode=OneWay}"
                                   ValueChanged="OnBehaviorChanged" />
                        <NumberBox x:Name="ApprovalHoldSeconds"
                                   Header="How long you can take something back (seconds after approval)"
                                   Value="{x:Bind Settings.ApprovalHoldSeconds, Mode=OneWay}"
                                   Minimum="0"
                                   Maximum="300"
                                   SmallChange="1"
                                   SpinButtonPlacementMode="Inline"
                                   IsEnabled="{x:Bind Settings.IsNotBusy, Mode=OneWay}"
                                   ValueChanged="OnBehaviorChanged" />
                        <TextBlock Text="No undo window. Approving sends on the next pass."
                                   Visibility="{x:Bind Settings.HasNoUndoWindow, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <NumberBox x:Name="DigestHours"
                                   Header="How often you can be interrupted (hours between notifications, at most)"
                                   Value="{x:Bind Settings.DigestHours, Mode=OneWay}"
                                   Minimum="1"
                                   Maximum="24"
                                   SmallChange="1"
                                   SpinButtonPlacementMode="Inline"
                                   IsEnabled="{x:Bind Settings.IsNotBusy, Mode=OneWay}"
                                   ValueChanged="OnBehaviorChanged" />
                        <TextBlock Text="{x:Bind Settings.QueueExpiryText, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.NotificationOwnerText, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="These govern the background watcher, not this window, and take effect as soon as they are changed. The same values are readable and settable from the command line."
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Text="PROJECTS"
                           Style="{StaticResource TcEyebrowTextStyle}" />
                <TextBlock Text="No projects seen yet."
                           Visibility="{x:Bind Settings.HasNoProjects, Mode=OneWay}"
                           Style="{StaticResource TcCaptionTextStyle}" />
                <ItemsControl ItemsSource="{x:Bind Settings.Projects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectSettingViewModel">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,3">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{x:Bind ProjectLabel}"
                                               Style="{StaticResource TcBodyDenseTextStyle}"
                                               TextWrapping="Wrap" />
                                    <!--
                                        Only the unresolvable bucket carries a
                                        note, saying why it can never be armed.
                                        Collapsed on every other row.
                                    -->
                                    <TextBlock Text="{x:Bind Note}"
                                               Visibility="{x:Bind HasNote}"
                                               Style="{StaticResource TcCaptionTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <!--
                                    Top rather than centre: a row carrying the
                                    note is three times the height of an
                                    ordinary one, and centred controls would
                                    float away from the name they act on.
                                -->
                                <TextBlock Grid.Column="1" Text="{x:Bind StateText, Mode=OneWay}"
                                           Style="{StaticResource TcCaptionTextStyle}"
                                           VerticalAlignment="Top" />
                                <Button Grid.Column="2" Content="{x:Bind ActionText, Mode=OneWay}"
                                        IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                        VerticalAlignment="Top"
                                        Click="OnProjectMode"
                                        Style="{StaticResource TcSecondaryButtonStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    The routing surface.

                    Every string in this block is bound. Not one is typed
                    here: the wording lives once, in
                    crates/trace-commons-contributor/src/routing_copy.rs, and
                    reaches this shell across the C ABI. One of the four words
                    is a privacy claim, so a word invented in this file would
                    be a claim invented in this file.

                    The whole section is collapsed when those words did not
                    arrive, rather than rendered with blanks beside the tool
                    names.
                -->
                <TextBlock Text="{x:Bind Settings.RoutingToolsHeading, Mode=OneWay}"
                           Visibility="{x:Bind Settings.RoutingAvailable, Mode=OneWay}"
                           Style="{StaticResource TcEyebrowTextStyle}" />
                <Border Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Padding="14,12"
                        Visibility="{x:Bind Settings.RoutingAvailable, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind Settings.RoutingIntro, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />

                        <!--
                            One row per tool, one word each. The word comes
                            from what IronWire answered about that tool, never
                            from the switch below.
                        -->
                        <ItemsControl ItemsSource="{x:Bind Settings.RoutingToolRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RoutingToolRowViewModel">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8"
                                          Margin="0,2"
                                          AutomationProperties.Name="{x:Bind AccessibleLabel}">
                                        <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                                   Style="{StaticResource TcBodyDenseTextStyle}"
                                                   TextWrapping="Wrap" />
                                        <!--
                                            The wired row is toned and the
                                            other three are not, matching the
                                            GTK shell. Which one is drawn
                                            comes from the shared table's
                                            tone, never from the word's text:
                                            "Private" is a substring of a
                                            denial that must never come back.
                                        -->
                                        <TextBlock Grid.Column="1" Text="{x:Bind Word}"
                                                   Style="{StaticResource TcMonoChipTextStyle}"
                                                   Visibility="{x:Bind ShowsNeutralWord}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Word}"
                                                   Style="{StaticResource TcMonoChipTextStyle}"
                                                   Foreground="{ThemeResource TcGreenTextBrush}"
                                                   Visibility="{x:Bind ShowsClearWord}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ToggleSwitch Header="{x:Bind Settings.RoutingToggleText, Mode=OneWay}"
                                      IsOn="{x:Bind Settings.RoutingDeclared, Mode=OneWay}"
                                      IsEnabled="{x:Bind Settings.IsNotBusy, Mode=OneWay}"
                                      Toggled="OnRoutingToggled" />
                        <TextBlock Text="{x:Bind Settings.RoutingAppliesAtOnceText, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />

                        <!--
                            What the machine already knows, before anything it
                            is asked. IronWire writes a pointer when its daemon
                            binds, so on a machine running it there is nothing
                            here to look up; on a machine without it this
                            sentence says so without saying anything is wrong,
                            because nothing is.
                        -->
                        <TextBlock Text="{x:Bind Settings.RoutingDiscoveryText, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!--
                                Offered only where there is something to
                                connect to and nothing is declared: this is
                                the shortcut past the two boxes, not a
                                second Apply.
                            -->
                            <Button Content="{x:Bind Settings.RoutingConnectText, Mode=OneWay}"
                                    Visibility="{x:Bind Settings.RoutingConnectOffered, Mode=OneWay}"
                                    IsEnabled="{x:Bind Settings.RoutingConnectOffered, Mode=OneWay}"
                                    Click="OnRoutingConnect"
                                    Style="{StaticResource TcSecondaryButtonStyle}" />
                            <!--
                                Offered rather than polled: this card does not
                                go looking at a file on a timer.
                            -->
                            <Button Content="{x:Bind Settings.RoutingLookAgainText, Mode=OneWay}"
                                    IsEnabled="{x:Bind Settings.IsNotBusy, Mode=OneWay}"
                                    Click="OnRoutingLookAgain"
                                    Style="{StaticResource TcSecondaryButtonStyle}" />
                        </StackPanel>

                        <!--
                            The port box shows the conventional number so
                            nobody has to know it, or the one discovery found
                            where nothing is declared. Showing is not
                            declaring: nothing is written until the switch
                            above is on.

                            Both boxes sit behind a disclosure once discovery
                            has supplied the port, and stay open where it has
                            not. There they are the only way to answer; this
                            inverts the default; it removes nothing.
                        -->
                        <Expander Header="{x:Bind Settings.RoutingOverrideTitle, Mode=OneWay}"
                                  IsExpanded="{x:Bind Settings.RoutingOverrideOpen, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <NumberBox Header="{x:Bind Settings.RoutingPortTitle, Mode=OneWay}"
                                           Value="{x:Bind Settings.RoutingPort, Mode=TwoWay}"
                                           Minimum="1"
                                           Maximum="65535"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Inline"
                                           IsEnabled="{x:Bind Settings.RoutingControlsEnabled, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Settings.RoutingPortNote, Mode=OneWay}"
                                           Style="{StaticResource TcCaptionTextStyle}"
                                           TextWrapping="Wrap" />

                                <!--
                                    Still a text box here, deliberately. The
                                    macOS folder control is a chooser because
                                    on that platform a directory is readable
                                    when the person pointed at it through the
                                    system panel, not when the app was told a
                                    string. No such rule holds on this one.
                                -->
                                <TextBox Header="{x:Bind Settings.RoutingFolderTitle, Mode=OneWay}"
                                         Text="{x:Bind Settings.RoutingTokenDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{x:Bind Settings.RoutingControlsEnabled, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Settings.RoutingFolderNote, Mode=OneWay}"
                                           Style="{StaticResource TcCaptionTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>

                        <Button Content="{x:Bind Settings.RoutingApplyText, Mode=OneWay}"
                                IsEnabled="{x:Bind Settings.RoutingControlsEnabled, Mode=OneWay}"
                                Click="OnRoutingApply"
                                Style="{StaticResource TcSecondaryButtonStyle}" />

                        <TextBlock Text="{x:Bind Settings.RoutingProbeText, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.HasRoutingProbeText, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <!--
                            The state sentence, painted from the daemon's
                            state and never from its own text. awaiting_rows
                            is held, not broken. The last of the four is the
                            only one that asks for something: declared, with
                            no reader built. It is painted apart from the
                            other three because neutral reads as off and held
                            reads as normal.
                        -->
                        <TextBlock Text="{x:Bind Settings.RoutingOrigin, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.HasRoutingOrigin, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.RoutingStateText, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.RoutingStateIsNeutral, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.RoutingStateText, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.RoutingStateIsHeld, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcBlueBrandBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.RoutingStateText, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.RoutingStateIsClear, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcGreenTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.RoutingStateText, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.RoutingStateIsAttention, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcGoldTextBrush}"
                                   TextWrapping="Wrap" />
                        <!--
                            Per process, and shown only where there has been an
                            answer to be last. Never an install date.
                        -->
                        <TextBlock Text="{x:Bind Settings.RoutingLastChecked, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.HasRoutingLastChecked, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--
                    Answering model calls on this computer.

                    The switch, the exposure sentence and the line saying what
                    the listener actually did all live on the model-calls
                    destination now: that is the one place that can show the
                    state beside the control, and it was five cards down this
                    list before.

                    The card stays rather than going. Somebody who learned
                    where the switch was should find a sentence and a way
                    there, not a hole.

                    Nothing on it is painted as working, because nothing on it
                    reports a state: the indicator belongs beside the switch,
                    on the page that has both.

                    Every string in this block is bound. Not one is typed
                    here: the wording lives once, in
                    crates/trace-commons-contributor/src/private_inference_copy.rs,
                    and reaches this shell across the C ABI. The whole card is
                    collapsed when those words did not arrive.
                -->
                <TextBlock Text="{x:Bind Settings.PrivateInferenceTitle, Mode=OneWay}"
                           Visibility="{x:Bind Settings.PrivateInferenceAvailable, Mode=OneWay}"
                           Style="{StaticResource TcEyebrowTextStyle}" />
                <Border Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Padding="14,12"
                        Visibility="{x:Bind Settings.PrivateInferenceAvailable, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind Settings.PrivateInferenceMoved, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <!--
                            The button carries the destination's own label, so
                            the rail and this pointer can never name it
                            differently.
                        -->
                        <Button Content="{x:Bind Settings.PrivateInferenceDestination, Mode=OneWay}"
                                HorizontalAlignment="Left"
                                Click="OnOpenPrivateInference" />
                    </StackPanel>
                </Border>

                <!--
                    The redaction witness.

                    Every word on this card arrives from the Rust through
                    tc_witness_copy, tc_witness_state_line and
                    tc_witness_last_result_line. There is not one string
                    literal in it, and there must never be: the sentences here
                    say what happens to a raw session, and a copy of one kept
                    on this shell would stop matching the other two the day it
                    changed.

                    The whole card is collapsed where those words did not
                    arrive, rather than rendered with blanks under a heading
                    about privacy.
                -->
                <TextBlock Text="{x:Bind Settings.WitnessHeading, Mode=OneWay}"
                           Visibility="{x:Bind Settings.WitnessAvailable, Mode=OneWay}"
                           Style="{StaticResource TcEyebrowTextStyle}" />
                <Border Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Padding="14,12"
                        Visibility="{x:Bind Settings.WitnessAvailable, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind Settings.WitnessIntro, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <!--
                            What a certificate establishes, and what it does
                            not. Carried whole from the Rust and never
                            summarised: a shorter version of this is a claim
                            that a session is clean, which no certificate
                            makes.
                        -->
                        <TextBlock Text="{x:Bind Settings.InferenceEvidenceHeading}" Style="{StaticResource TcEyebrowTextStyle}" />
                        <TextBlock Text="{x:Bind Settings.InferenceEvidenceDisclosure}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.InferenceEvidenceCaptureNote}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.InferenceEvidenceScopeNote}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.InferenceEvidenceState, Mode=OneWay}" TextWrapping="Wrap" />
                        <Button Content="{x:Bind Settings.InferenceEvidenceEnable, Mode=OneWay}"
                                IsEnabled="{x:Bind Settings.InferenceEvidenceControlsEnabled, Mode=OneWay}"
                                Click="OnInferenceEvidence" />
                        <Button Content="{x:Bind Settings.InferenceEvidenceDisable}"
                                IsEnabled="{x:Bind Settings.WitnessControlsEnabled, Mode=OneWay}"
                                Click="OnDisableInferenceEvidence" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Text="{x:Bind Settings.InferenceEvidenceNoticeGlyph, Mode=OneWay}" Style="{StaticResource TcHeadingAlertTextStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Settings.InferenceEvidenceNotice, Mode=OneWay}" Style="{StaticResource TcHeadingAlertTextStyle}" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="{x:Bind Settings.TokenContributionHeading}" Style="{StaticResource TcEyebrowTextStyle}" />
                        <TextBlock Text="{x:Bind Settings.TokenContributionDisclosure}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.TokenContributionCaptureNote}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.TokenContributionScopeNote}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.ProbabilityStorage.CaptureNotice, Mode=OneWay}" TextWrapping="Wrap" />
            <Button Content="{x:Bind Settings.ProbabilityStorage.CaptureLabel, Mode=OneWay}" Click="OnLocalProbabilityCapture" />
            <TextBlock Text="{x:Bind Settings.ProbabilityStorage.StateLine, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind Settings.ProbabilityStorage.ScopeNote, Mode=OneWay}" TextWrapping="Wrap" />
            <Button Content="{x:Bind Settings.ProbabilityStorage.CleanupLabel, Mode=OneWay}" Click="OnCleanProbabilityStorage" />
            <Button Content="{x:Bind Settings.ProbabilityStorage.DiscardLabel, Mode=OneWay}" Click="OnDiscardProbabilityStorage" />
            <TextBlock Text="{x:Bind Settings.TokenContributionState, Mode=OneWay}" TextWrapping="Wrap" />
                        <Button Content="{x:Bind Settings.TokenContributionEnable, Mode=OneWay}"
                                IsEnabled="{x:Bind Settings.TokenContributionControlsEnabled, Mode=OneWay}"
                                Click="OnTokenContribution" />
                        <Button Content="{x:Bind Settings.TokenContributionDisable}"
                                IsEnabled="{x:Bind Settings.WitnessControlsEnabled, Mode=OneWay}"
                                Click="OnDisableTokenContribution" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Text="{x:Bind Settings.TokenContributionNoticeGlyph, Mode=OneWay}" Style="{StaticResource TcHeadingAlertTextStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Settings.TokenContributionNotice, Mode=OneWay}" Style="{StaticResource TcHeadingAlertTextStyle}" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="{x:Bind Settings.WitnessCertificateMeans, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />

                        <!--
                            The state sentence, painted from the state code and
                            never from its own text.

                            FIVE BRANCHES, NOT FOUR. The refused branch is its
                            own, and is not the attention one: attention says
                            something needs fixing while sessions still go out,
                            and on a refusal nothing goes out at all. It is the
                            only reading on this screen painted coral.

                            The neutral branch is where "no witness" lands, and
                            that is not a warning. Redaction happens on this machine,
                            which is the ordinary arrangement.
                        -->
                        <TextBlock Text="{x:Bind Settings.WitnessStateText, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.WitnessStateIsNeutral, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.WitnessStateText, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.WitnessStateIsHeld, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcBlueBrandBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.WitnessStateText, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.WitnessStateIsClear, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcGreenTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.WitnessStateText, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.WitnessStateIsAttention, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcGoldTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.WitnessStateText, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.WitnessStateIsRefused, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcCoralTextBrush}"
                                   TextWrapping="Wrap" />

                        <!--
                            What the last session sent did about the witness.
                            Per process: a freshly started app has seen none,
                            and says so rather than guessing. The same five
                            branches, for the same reason.
                        -->
                        <TextBlock Text="{x:Bind Settings.WitnessLastResultText, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.WitnessLastResultIsNeutral, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.WitnessLastResultText, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.WitnessLastResultIsHeld, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcBlueBrandBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.WitnessLastResultText, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.WitnessLastResultIsClear, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcGreenTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.WitnessLastResultText, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.WitnessLastResultIsAttention, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcGoldTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.WitnessLastResultText, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.WitnessLastResultIsRefused, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcCoralTextBrush}"
                                   TextWrapping="Wrap" />

                        <!--
                            The way out of a refusal, and the way in.

                            Open by default on every refusing state, because a
                            refusal a contributor cannot act on is a dead end
                            and these three fields are what resolves all of
                            them. Collapsed on the two readings that are not
                            refusals, where opening it would present the
                            ordinary arrangement as something needing repair.
                        -->
                        <Expander Header="{x:Bind Settings.WitnessConfigureText, Mode=OneWay}"
                                  IsExpanded="{x:Bind Settings.WitnessEditorOpen, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <!--
                                    Shown verbatim, deliberately. A screen that
                                    will not name what it is asking somebody to
                                    trust with their raw session is not a
                                    settings screen.
                                -->
                                <TextBox Header="{x:Bind Settings.WitnessUrlTitle, Mode=OneWay}"
                                         Text="{x:Bind Settings.WitnessUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{x:Bind Settings.WitnessControlsEnabled, Mode=OneWay}" />
                                <TextBox Header="{x:Bind Settings.WitnessSigningAddressTitle, Mode=OneWay}"
                                         Text="{x:Bind Settings.WitnessSigningAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{x:Bind Settings.WitnessControlsEnabled, Mode=OneWay}" />
                                <!--
                                    One measurement set per line. A list, not a
                                    value: an upgrade moves the measurement and
                                    leaves the signing address alone, so the
                                    new one goes in before the fleet rolls.
                                -->
                                <TextBox Header="{x:Bind Settings.WitnessMeasurementsTitle, Mode=OneWay}"
                                         Text="{x:Bind Settings.WitnessMeasurements, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="72"
                                         IsEnabled="{x:Bind Settings.WitnessControlsEnabled, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Settings.WitnessMeasurementsNote, Mode=OneWay}"
                                           Style="{StaticResource TcCaptionTextStyle}"
                                           TextWrapping="Wrap" />
                                <!--
                                    How many are pinned, in the Rust's own
                                    sentence. Shown only where there was one:
                                    it is absent on the readings with no
                                    witness to count for, and a bare numeral
                                    in its place would be this shell inventing
                                    wording by omission.
                                -->
                                <TextBlock Text="{x:Bind Settings.WitnessMeasurementLine, Mode=OneWay}"
                                           Visibility="{x:Bind Settings.HasWitnessMeasurementLine, Mode=OneWay}"
                                           Style="{StaticResource TcCaptionTextStyle}"
                                           TextWrapping="Wrap" />
                                <Button Content="{x:Bind Settings.WitnessConfigureText, Mode=OneWay}"
                                        IsEnabled="{x:Bind Settings.WitnessControlsEnabled, Mode=OneWay}"
                                        Click="OnWitnessConfigure"
                                        Style="{StaticResource TcSecondaryButtonStyle}" />
                            </StackPanel>
                        </Expander>

                        <!--
                            Stopping, with the sentence that says what stopping
                            actually does beside it. Not "off": the redaction
                            still happens, on this machine.
                        -->
                        <Button Content="{x:Bind Settings.WitnessClearText, Mode=OneWay}"
                                IsEnabled="{x:Bind Settings.WitnessControlsEnabled, Mode=OneWay}"
                                Click="OnWitnessClear"
                                Style="{StaticResource TcSecondaryButtonStyle}" />
                        <TextBlock Text="{x:Bind Settings.WitnessClearNote, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.WitnessAppliesAtOnceText, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Bind Settings.Notice, Mode=OneWay}"
                           Visibility="{x:Bind Settings.HasNotice, Mode=OneWay}"
                           Style="{StaticResource TcBodyDenseTextStyle}"
                           TextWrapping="Wrap" />

                <TextBlock Text="{x:Bind ViewModel.HeadingText}"
                           Style="{StaticResource TcTitleSectionTextStyle}" />

                <!--
                    Off the roster. One control, and turning it on does not
                    put anyone on the roster: it opens the consent dialog,
                    which is where the handle is typed and the acknowledgement
                    is given. Nothing is claimed by a toggle flip.
                -->
                <Border Visibility="{x:Bind ViewModel.IsNotListed, Mode=OneWay}"
                        Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Padding="14,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind ViewModel.ListHandlePubliclyText}"
                                   Style="{StaticResource TcBodyTextStyle}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <!--
                            A ToggleSwitch with no on/off words, because the
                            row's own label already says what it does and the
                            switch is never the thing that grants anything.
                            It is put back to off if the dialog is abandoned:
                            see OnGoPublicToggled.
                        -->
                        <ToggleSwitch x:Name="GoPublicToggle"
                                      Grid.Column="1"
                                      OnContent=""
                                      OffContent=""
                                      IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                      AutomationProperties.Name="{x:Bind ViewModel.ListHandlePubliclyText}"
                                      Toggled="OnGoPublicToggled" />
                    </Grid>
                </Border>

                <!--
                    On the roster. The fields as published, and the two acts
                    available on them.

                    Save re-publishes the WHOLE profile, because that is what
                    the PUT does: the handle and the bio as they stand in
                    these two boxes, both of them, every time. There is no
                    partial update to offer, so there is no per field save.
                -->
                <Border Visibility="{x:Bind ViewModel.IsListed, Mode=OneWay}"
                        Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcGreenChipBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Padding="16,14">
                    <StackPanel Spacing="12">

                        <TextBlock Text="{x:Bind ViewModel.OnRosterSinceText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasOnRosterSince, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   HorizontalAlignment="Right" />

                        <TextBox Header="{x:Bind ViewModel.HandleLabelText}"
                                 Text="{x:Bind ViewModel.Handle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{ThemeResource TcMonoFontFamily}"
                                 IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />

                        <StackPanel Spacing="4">
                            <TextBox Header="{x:Bind ViewModel.BioLabelText}"
                                     Text="{x:Bind ViewModel.Bio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="78"
                                     IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                            <!--
                                The counter counts UTF-8 bytes, which is the
                                unit the budget is denominated in, and it
                                refuses nothing: what happens at and above the
                                limit is the server's call.
                            -->
                            <TextBlock Text="{x:Bind ViewModel.BioCounterText, Mode=OneWay}"
                                       Style="{StaticResource TcCaptionSmallTextStyle}"
                                       HorizontalAlignment="Right" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource TcPrimaryButtonStyle}"
                                    Content="{x:Bind ViewModel.SaveProfileText}"
                                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                    Click="OnSaveProfile" />
                            <Button Style="{StaticResource TcSecondaryButtonStyle}"
                                    Content="{x:Bind ViewModel.LeaveRosterText}"
                                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                    Click="OnLeaveRoster" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--
                    What the last act actually did. It is the one place this
                    screen reports an outcome, and the sentence is chosen in
                    TraceCommons.Interop.PublicProfileCopy rather than here: a
                    claim the daemon could not cache locally is still a
                    PUBLISHED profile, and saying otherwise is the one error
                    this surface must never make.
                -->
                <TextBlock Text="{x:Bind ViewModel.Notice, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                           Style="{StaticResource TcBodyDenseTextStyle}"
                           TextWrapping="Wrap" />

                <TextBlock Text="{x:Bind ViewModel.FootnoteText}"
                           Style="{StaticResource TcCaptionTextStyle}"
                           Foreground="{ThemeResource TcInkTertiaryBrush}"
                           TextWrapping="Wrap" />

                <TextBlock Text="WHAT HAS BEEN CHANGED ON THIS MACHINE"
                           Style="{StaticResource TcEyebrowTextStyle}" />
                <TextBlock Text="Nothing has been changed."
                           Visibility="{x:Bind Settings.HasNoAuditEntries, Mode=OneWay}"
                           Style="{StaticResource TcCaptionTextStyle}" />
                <ItemsControl ItemsSource="{x:Bind Settings.AuditEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AuditSettingViewModel">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,3">
                                <TextBlock Grid.Column="0" Text="{x:Bind AtText}"
                                           Style="{StaticResource TcMonoChipTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind WhatText}"
                                           Style="{StaticResource TcCaptionTextStyle}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
